pipeline {
    agent { label 'agent2' }

    stages {
       stage('get from git'){
           steps{
               git branch:'main',url:'https://github.com/VforVijay31/RealBPO.git'
           }
       }


        stage('docker build') {
            steps {
                sh '''
                    docker build -t vijayshriram2005/realbpo:v2 .
                '''   }
        }
        stage('docker push'){
            steps{
                withCredentials([usernamePassword(credentialsId: 'dhubcred', passwordVariable: 'DOCKER_PASS', usernameVariable: 'DOCKER_USER')]) {
                    sh '''
                        echo $DOCKER_PASS | docker login -u "$DOCKER_USER" --password-stdin
                        docker push vijayshriram2005/realbpo:v2
                    '''
                }
            }
        }

        
    }
}
